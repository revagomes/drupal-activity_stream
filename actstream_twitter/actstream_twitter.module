<?php

/**
 * @file
 * Fetch X (Twitter) posts into the Activity Stream via the X API v2.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_actstream_services().
 */
function actstream_twitter_actstream_services(): array {
  $module_path = \Drupal::service('extension.list.module')->getPath('actstream_twitter');
  return [
    'twitter' => [
      'type' => 'twitter',
      'name' => t('X (Twitter)'),
      'verb' => t('posted'),
      'icon' => $module_path . '/twitter.png',
    ],
  ];
}

/**
 * Implements hook_form_actstream_accounts_form_alter().
 */
function actstream_twitter_form_actstream_accounts_form_alter(array &$form, FormStateInterface $form_state): void {
  $user = $form['#user'];
  $uid = $user ? $user->id() : \Drupal::currentUser()->id();
  $data = actstream_account_load('twitter', $uid);

  // Normalise legacy storage (bare string) to array.
  if (is_string($data)) {
    $data = ['username' => $data];
  }

  $form['actstream_twitter'] = [
    '#type' => 'fieldset',
    '#title' => t('X (Twitter)'),
  ];
  $form['actstream_twitter']['actstream_twitter_username'] = [
    '#type' => 'textfield',
    '#title' => t('X (Twitter) username'),
    '#default_value' => $data['username'] ?? '',
    '#description' => t('Your X username without the @ sign (e.g. drupal).'),
    '#field_prefix' => '@',
  ];

  $form['#submit'][] = 'actstream_twitter_form_actstream_accounts_form_submit';
}

/**
 * Form submit handler for X account configuration.
 */
function actstream_twitter_form_actstream_accounts_form_submit(array &$form, FormStateInterface $form_state): void {
  $user = $form['#user'];
  $uid = $user ? $user->id() : \Drupal::currentUser()->id();
  $username = trim(ltrim($form_state->getValue('actstream_twitter_username', ''), '@'));

  if ($username !== '') {
    actstream_account_save('twitter', ['username' => $username], $uid);
  }
  else {
    actstream_account_delete('twitter', $uid);
  }
}

/**
 * Implements hook_actstream_twitter_items_fetch().
 *
 * Uses the X API v2 app-only Bearer token to fetch the user's recent posts.
 */
function actstream_twitter_actstream_twitter_items_fetch(int $uid, mixed $data): array {
  $bearer_token = \Drupal::config('actstream_twitter.settings')->get('bearer_token');

  // Normalise legacy storage (bare string) to array.
  if (is_string($data)) {
    $data = ['username' => $data];
  }

  if (empty($bearer_token) || empty($data['username'])) {
    return [];
  }

  $username = $data['username'];

  try {
    $client = \Drupal::httpClient();
    $headers = ['Authorization' => 'Bearer ' . $bearer_token];

    // Step 1: resolve username to numeric user ID.
    $user_response = $client->get(
      'https://api.twitter.com/2/users/by/username/' . rawurlencode($username),
      ['headers' => $headers]
    );
    $user_payload = json_decode((string) $user_response->getBody(), TRUE);

    if (empty($user_payload['data']['id'])) {
      \Drupal::logger('actstream_twitter')->warning('X API: user not found for username @u.', ['@u' => $username]);
      return [];
    }
    $x_user_id = $user_payload['data']['id'];

    // Step 2: fetch the user's recent posts.
    $tweets_response = $client->get(
      'https://api.twitter.com/2/users/' . $x_user_id . '/tweets',
      [
        'headers' => $headers,
        'query' => [
          'tweet.fields' => 'created_at,author_id',
          'max_results' => 20,
          'exclude' => 'retweets,replies',
        ],
      ]
    );
    $tweets_payload = json_decode((string) $tweets_response->getBody(), TRUE);

    if (empty($tweets_payload['data'])) {
      return [];
    }

    $items = [];
    foreach ($tweets_payload['data'] as $tweet) {
      $tweet_id = $tweet['id'];
      $post_url = 'https://x.com/' . rawurlencode($username) . '/status/' . $tweet_id;
      $timestamp = isset($tweet['created_at'])
        ? (int) (new \DateTimeImmutable($tweet['created_at']))->getTimestamp()
        : time();

      $items[] = [
        'title' => mb_substr($tweet['text'], 0, 255),
        'body' => $tweet['text'],
        'link' => $post_url,
        'timestamp' => $timestamp,
        'guid' => 'twitter:' . $tweet_id,
        'raw' => json_encode($tweet),
      ];
    }
    return $items;
  }
  catch (\Exception $e) {
    \Drupal::logger('actstream_twitter')->error('X API error for uid @uid: @msg', [
      '@uid' => $uid,
      '@msg' => $e->getMessage(),
    ]);
    return [];
  }
}
