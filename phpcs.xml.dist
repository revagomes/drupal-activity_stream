<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="activity_stream">
  <description>Drupal coding standards for Activity Stream.</description>
  <file>src</file>
  <file>activity_stream.module</file>
  <file>activity_stream.install</file>
  <file>activity_stream_feed/activity_stream_feed.module</file>
  <file>activity_stream_feed/activity_stream_feed.install</file>
  <file>activity_stream_twitter/activity_stream_twitter.module</file>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
  <!-- SimplePie is a vendored library, not subject to Drupal CS -->
  <exclude-pattern>activity_stream_feed/SimplePie.compiled.php</exclude-pattern>
</ruleset>
