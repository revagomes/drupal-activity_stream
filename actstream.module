<?php

/**
 * @file
 * Aggregates web activity from external services into Drupal.
 */

use Drupal\Core\Url;

/**
 * Prepares variables for actstream_item templates.
 *
 * Default template: actstream-item.html.twig.
 *
 * @param array $variables
 *   An associative array of template variables.
 */
function template_preprocess_actstream_item(array &$variables): void {
  /** @var \Drupal\actstream\Entity\ActivityStreamItem $item */
  $item = $variables['actstream_item'];
  $service_id = $item->get('service')->value;
  $services = actstream_services_load();
  $service = $services[$service_id] ?? [];
  $variables['service'] = $service;

  $link = $item->get('actstream_link')->value ?? '';
  $id = $item->id();

  // Statement: actor — verb — object.
  $variables['statement']['actor'] = [
    '#theme' => 'username',
    '#account' => $item->get('uid')->entity,
  ];
  $variables['statement']['verb'] = [
    '#markup' => $service['verb'] ?? '',
  ];
  $variables['statement']['object'] = $link ? [
    '#type' => 'link',
    '#title' => $item->label(),
    '#url' => Url::fromUri($link),
  ] : ['#plain_text' => $item->label()];

  // Time ago.
  $variables['time_ago'] = [
    '#markup' => t('@time ago', [
      '@time' => \Drupal::service('date.formatter')->formatInterval(
        \Drupal::time()->getRequestTime() - $item->get('created')->value,
        1
      ),
    ]),
  ];

  // Service icon.
  if (!empty($service['icon'])) {
    $icon_uri = $service['icon'];
    $variables['service_icon'] = [
      '#theme' => 'image',
      '#uri' => $icon_uri,
      '#alt' => $service['name'] ?? '',
    ];
  }

  // Permalink icon: links to the canonical entity route.
  $module_path = \Drupal::service('extension.list.module')->getPath('actstream');
  $permalink_icon_uri = '/' . $module_path . '/images/permalink.png';
  $variables['permalink_icon'] = [
    '#type' => 'link',
    '#title' => [
      '#theme' => 'image',
      '#uri' => $permalink_icon_uri,
      '#alt' => t('Permalink'),
    ],
    '#url' => Url::fromRoute('entity.actstream_item.canonical', [
      'actstream_item' => $id,
    ]),
  ];

  // External icon: links to the original item URL (omitted when link is empty).
  $external_icon_uri = '/' . $module_path . '/images/external.png';
  if (!empty($link)) {
    $variables['external_icon'] = [
      '#type' => 'link',
      '#title' => [
        '#theme' => 'image',
        '#uri' => $external_icon_uri,
        '#alt' => t('External link'),
      ],
      '#url' => Url::fromUri($link),
      '#options' => ['attributes' => ['target' => '_blank', 'rel' => 'noopener noreferrer']],
    ];
  }
}

/**
 * Loads all registered actstream service definitions.
 *
 * @return array
 *   Associative array of service definitions keyed by service machine name.
 */
function actstream_services_load(): array {
  $services = &drupal_static(__FUNCTION__);
  if (!isset($services)) {
    $services = \Drupal::moduleHandler()->invokeAll('actstream_services');
  }
  return $services;
}

/**
 * Loads account data for a service and user.
 *
 * @param string $service
 *   The service machine name.
 * @param int|null $uid
 *   The user ID. Defaults to the current user.
 *
 * @return mixed
 *   The unserialized account data, or NULL if not found.
 */
function actstream_account_load(string $service, ?int $uid = NULL): mixed {
  $uid = $uid ?? \Drupal::currentUser()->id();
  $data = \Drupal::database()
    ->select('actstream_account', 'a')
    ->fields('a', ['data'])
    ->condition('service', $service)
    ->condition('uid', $uid)
    ->execute()
    ->fetchField();
  return $data !== FALSE ? unserialize($data) : NULL;
}

/**
 * Saves account data for a service and user.
 *
 * @param string $service
 *   The service machine name.
 * @param mixed $data
 *   The data to store (will be serialized).
 * @param int|null $uid
 *   The user ID. Defaults to the current user.
 */
function actstream_account_save(string $service, mixed $data, ?int $uid = NULL): void {
  $uid = $uid ?? \Drupal::currentUser()->id();
  \Drupal::database()->merge('actstream_account')
    ->keys(['uid' => $uid, 'service' => $service])
    ->fields(['data' => serialize($data)])
    ->execute();
}

/**
 * Deletes account data for a service and user.
 *
 * @param string $service
 *   The service machine name.
 * @param int|null $uid
 *   The user ID. Defaults to the current user.
 */
function actstream_account_delete(string $service, ?int $uid = NULL): void {
  $uid = $uid ?? \Drupal::currentUser()->id();
  \Drupal::database()->delete('actstream_account')
    ->condition('service', $service)
    ->condition('uid', $uid)
    ->execute();
}

/**
 * Fetches items for a given service and user by invoking service hooks.
 *
 * @param int $uid
 *   The user ID.
 * @param string $service
 *   The service machine name.
 * @param mixed $data
 *   Account data for the service.
 *
 * @return array
 *   Array of item arrays returned by the service hook.
 */
function actstream_items_fetch(int $uid, string $service, mixed $data): array {
  $items = \Drupal::moduleHandler()->invokeAll('actstream_' . $service . '_items_fetch', [$uid, $data]);
  \Drupal::moduleHandler()->alter('actstream_' . $service . '_items', $items, $uid, $data);
  return $items;
}

/**
 * Loads actstream_item entities, optionally filtered by user.
 *
 * @param int|null $uid
 *   The user ID to filter by, or NULL for all users.
 * @param int $count
 *   The number of items to load per page.
 *
 * @return \Drupal\actstream\Entity\ActivityStreamItem[]
 *   Array of ActivityStreamItem entities.
 */
function actstream_items_load(?int $uid = NULL, int $count = 20): array {
  $query = \Drupal::entityQuery('actstream_item')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->pager($count)
    ->accessCheck(TRUE);
  if ($uid !== NULL) {
    $query->condition('uid', $uid);
  }
  $ids = $query->execute();
  if (empty($ids)) {
    return [];
  }
  return \Drupal::entityTypeManager()->getStorage('actstream_item')->loadMultiple($ids);
}

/**
 * Saves an array of fetched items as actstream_item entities.
 *
 * Skips items that already exist and have not changed. Creates new entities
 * for new items and updates changed existing items.
 *
 * @param int $uid
 *   The user ID.
 * @param string $service
 *   The service machine name.
 * @param array $items
 *   Array of item arrays with keys: title, link, body, timestamp, guid, raw.
 */
function actstream_items_save(int $uid, string $service, array $items): void {
  if (empty($items)) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('actstream_item');

  // Build a GUID-keyed map; use link as fallback when guid is absent.
  $guid_map = [];
  foreach ($items as $item) {
    $guid = !empty($item['guid']) ? $item['guid'] : ($item['link'] ?? '');
    $guid_map[$guid] = $item;
  }

  // Load all existing entities for this service+user in one query (avoids N+1).
  $existing = [];
  $existing_ids = \Drupal::entityQuery('actstream_item')
    ->condition('actstream_guid', array_keys($guid_map), 'IN')
    ->condition('service', $service)
    ->condition('uid', $uid)
    ->accessCheck(FALSE)
    ->execute();
  foreach ($storage->loadMultiple($existing_ids) as $entity) {
    $existing[$entity->get('actstream_guid')->value] = $entity;
  }

  foreach ($guid_map as $guid => $item) {
    if (isset($existing[$guid])) {
      $entity = $existing[$guid];
      if ($entity->label() === $item['title'] && $entity->get('actstream_body')->value === $item['body']) {
        continue;
      }
    }
    else {
      $entity = $storage->create(['service' => $service, 'uid' => $uid, 'status' => 1]);
    }
    $entity->set('title', $item['title']);
    $entity->set('created', $item['timestamp']);
    $entity->set('actstream_link', $item['link'] ?? '');
    $entity->set('actstream_guid', $guid);
    $entity->set('actstream_raw', $item['raw'] ?? '');
    $entity->set('actstream_body', $item['body'] ?? '');
    $entity->save();
  }
}
