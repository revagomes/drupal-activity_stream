<?php

/**
 * @file
 * Manages Activity Stream Events that drive hashtag aggregation for the wall.
 */

/**
 * Implements hook_cron().
 *
 * For each active event, fetches items from each configured service and saves
 * them with status=0 (pending moderation) and the event ID stamped on them.
 * Items use uid=1 (site admin). Existing items (same GUID) are skipped.
 */
function actstream_event_cron(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('actstream_event');
  $events = $storage->loadByProperties(['active' => TRUE]);

  foreach ($events as $event) {
    $hashtag = $event->getHashtag();
    $event_id = $event->id();

    foreach ($event->getServices() as $service_id) {
      $items = actstream_items_fetch(1, $service_id, ['hashtag' => $hashtag]);
      _actstream_event_save_pending($service_id, $event_id, $items);
    }
  }
}

/**
 * Saves fetched items as pending (status=0) event items.
 *
 * Skips any item whose GUID already exists for this service + event pair.
 * Does not update existing items — moderation status is preserved.
 *
 * @param string $service
 *   The service machine name.
 * @param string $event_id
 *   The actstream_event machine name.
 * @param array $items
 *   Items returned by actstream_items_fetch().
 */
function _actstream_event_save_pending(string $service, string $event_id, array $items): void {
  if (empty($items)) {
    return;
  }

  $item_storage = \Drupal::entityTypeManager()->getStorage('actstream_item');

  foreach ($items as $item) {
    $guid = !empty($item['guid']) ? $item['guid'] : $item['link'];

    $existing = \Drupal::entityQuery('actstream_item')
      ->condition('actstream_guid', $guid)
      ->condition('service', $service)
      ->condition('actstream_event_id', $event_id)
      ->accessCheck(FALSE)
      ->range(0, 1)
      ->execute();

    if (!empty($existing)) {
      continue;
    }

    $entity = $item_storage->create([
      'service' => $service,
      'uid' => 1,
      'status' => 0,
      'actstream_event_id' => $event_id,
    ]);
    $entity->set('title', $item['title']);
    $entity->set('created', $item['timestamp']);
    $entity->set('actstream_link', $item['link'] ?? '');
    $entity->set('actstream_guid', $guid);
    $entity->set('actstream_raw', $item['raw'] ?? '');
    $entity->set('actstream_body', $item['body'] ?? '');
    $entity->save();
  }
}
