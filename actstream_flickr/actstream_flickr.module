<?php

/**
 * @file
 * Fetch public Flickr photos into the Activity Stream.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_actstream_services().
 */
function actstream_flickr_actstream_services(): array {
  return [
    'flickr' => [
      'type' => 'flickr',
      'name' => t('Flickr'),
      'verb' => t('photographed'),
      'icon' => 'https://www.flickr.com/favicon.ico',
    ],
  ];
}

/**
 * Implements hook_form_actstream_accounts_form_alter().
 */
function actstream_flickr_form_actstream_accounts_form_alter(array &$form, FormStateInterface $form_state): void {
  $user = $form['#user'];
  $uid = $user ? $user->id() : \Drupal::currentUser()->id();
  $data = actstream_account_load('flickr', $uid) ?: [];

  $form['actstream_flickr'] = [
    '#type' => 'fieldset',
    '#title' => t('Flickr'),
  ];
  $form['actstream_flickr']['actstream_flickr_username'] = [
    '#type' => 'textfield',
    '#title' => t('Flickr username or NSID'),
    '#default_value' => $data['username'] ?? '',
    '#description' => t('Your Flickr username or NSID (e.g. 12345678@N00).'),
  ];

  $form['#submit'][] = 'actstream_flickr_form_actstream_accounts_form_submit';
}

/**
 * Form submit handler for Flickr account configuration.
 */
function actstream_flickr_form_actstream_accounts_form_submit(array &$form, FormStateInterface $form_state): void {
  $user = $form['#user'];
  $uid = $user ? $user->id() : \Drupal::currentUser()->id();
  $username = trim($form_state->getValue('actstream_flickr_username') ?? '');

  if ($username !== '') {
    actstream_account_save('flickr', ['username' => $username], $uid);
  }
  else {
    actstream_account_delete('flickr', $uid);
  }
}

/**
 * Implements hook_actstream_flickr_items_fetch().
 */
function actstream_flickr_actstream_flickr_items_fetch(int $uid, mixed $data): array {
  $api_key = \Drupal::config('actstream_flickr.settings')->get('api_key');
  if (empty($api_key) || empty($data['username'])) {
    return [];
  }

  try {
    $flickr = new \Samwilson\PhpFlickr\PhpFlickr($api_key);

    $person = $flickr->people()->findByUsername($data['username']);
    if (empty($person)) {
      return [];
    }
    $nsid = $person['id'] ?? $person['nsid'] ?? NULL;
    if (!$nsid) {
      return [];
    }

    $result = $flickr->people()->getPublicPhotos($nsid, NULL, 'date_upload', 20);
    if (empty($result['photo'])) {
      return [];
    }

    $items = [];
    foreach ($result['photo'] as $photo) {
      $page_url = 'https://www.flickr.com/photos/' . rawurlencode($photo['owner']) . '/' . $photo['id'] . '/';
      $img_url = 'https://farm' . $photo['farm'] . '.staticflickr.com/' . $photo['server'] . '/' . $photo['id'] . '_' . $photo['secret'] . '.jpg';
      $items[] = [
        'title' => $photo['title'] ?: t('Untitled photo'),
        'body' => $img_url,
        'link' => $page_url,
        'timestamp' => isset($photo['dateupload']) ? (int) $photo['dateupload'] : time(),
        'guid' => 'flickr:' . $photo['id'],
        'raw' => json_encode($photo),
      ];
    }
    return $items;
  }
  catch (\Exception $e) {
    \Drupal::logger('actstream_flickr')->error('Flickr API error for uid @uid: @msg', [
      '@uid' => $uid,
      '@msg' => $e->getMessage(),
    ]);
    return [];
  }
}
