{
  "name": "drupal/actstream",
  "description": "Aggregates your web activity from external services (RSS, etc.) into Drupal activity stream entities.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/sandbox/revagomes/actstream_entity",
  "authors": [
    {
      "name": "Reva Gomes",
      "homepage": "https://www.drupal.org/u/revagomes",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://www.drupal.org/project/issues/actstream_entity",
    "source": "https://git.drupal.org/sandbox/revagomes-2216775.git"
  },
  "require": {
    "php": "^8.1",
    "drupal/core": "^10.3 || ^11"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
